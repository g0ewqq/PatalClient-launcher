<Window x:Class="PatalClient.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:PatalClient.Launcher.UI"
        Title="PatalClient"
        Width="620" Height="500"
        MinWidth="500" MinHeight="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.RowSpan="3">
                <Ellipse x:Name="AmbientGlow"
                         Width="480" Height="480"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,-210,0,0"
                         Opacity="0.035"
                         IsHitTestVisible="False"
                         CacheMode="BitmapCache">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF3A5580" Offset="0" />
                            <GradientStop Color="#003A5580" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="False">
                    <ContentControl x:Name="LogoMarkHost" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="PatalClient"
                               Style="{StaticResource SecondaryTextStyle}"
                               FontWeight="SemiBold"
                               Margin="9,1,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ComboBox Grid.Column="1"
                          x:Name="VersionSelector"
                          Style="{StaticResource HeaderComboBoxStyle}"
                          Width="160"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"
                          SelectionChanged="VersionSelector_SelectionChanged" />

                <Button Grid.Column="2"
                        AutomationProperties.AutomationId="SettingsButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE713;"
                        Click="SettingsButton_Click" />
                <Button Grid.Column="3" Style="{StaticResource WindowButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0"
                                x:Name="LogoHost"
                                HorizontalAlignment="Center"
                                Margin="0,44,0,0" />

                <StackPanel Grid.Row="1" x:Name="HeroHost" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <TextBlock Text="PatalClient"
                               Style="{StaticResource TitleTextStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Minecraft Java Client"
                               Style="{StaticResource CaptionTextStyle}"
                               ui:TextSpacing.Tracking="1"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           x:Name="StatusText"
                           Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="400"
                           TextWrapping="Wrap"
                           Margin="0,20,0,0" />

                <Grid Grid.Row="3" x:Name="ControlsHost">
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,18,0,0"
                            Click="PrimaryButton_Click" />
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    x:Name="FooterHost"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterStatusText"
                                   Style="{StaticResource LabelTextStyle}"
                                   ui:TextSpacing.Tracking="1"
                                   Margin="9,1,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               x:Name="FooterVersionText"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
