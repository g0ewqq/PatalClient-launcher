<Window x:Class="PatalClient.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PatalClient.Launcher.UI"
        Title="PatalClient"
        Width="560" Height="480"
        MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource PrimaryFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal">
    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}">
                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <ContentControl Content="{DynamicResource LogoMark}" VerticalAlignment="Center" />
                            <TextBlock Text="PatalClient"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="8,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE713;" Click="SettingsButton_Click" />
                        <Button Grid.Column="2" Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="MinimizeButton_Click" />
                        <Button Grid.Column="3" Style="{StaticResource WindowButtonStyle}" Content="&#xE8BB;" Click="CloseButton_Click" />
                    </Grid>
                </Border>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0"
                                x:Name="LogoHost"
                                HorizontalAlignment="Center"
                                Margin="0,34,0,0" />

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="PatalClient"
                               Style="{StaticResource TitleTextStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Minecraft Java Client"
                               Style="{StaticResource CaptionTextStyle}"
                               ui:TextSpacing.Tracking="1"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           x:Name="StatusText"
                           Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="380"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0" />

                <Button Grid.Row="3"
                        x:Name="PrimaryButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Click="PrimaryButton_Click" />

                <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Minecraft Version"
                               Style="{StaticResource LabelTextStyle}"
                               HorizontalAlignment="Center" />
                    <ComboBox x:Name="VersionSelector"
                              Style="{StaticResource VersionComboBoxStyle}"
                              Width="240"
                              Margin="0,7,0,0"
                              SelectionChanged="VersionSelector_SelectionChanged" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Minecraft"
                                   Style="{StaticResource LabelTextStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterVersionText"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   FontWeight="Medium"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Status"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="24,0,0,0"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource TextDimBrush}" Margin="0,1,6,0" />
                            <TextBlock x:Name="FooterStatusText"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="zqxhyt"
                               Style="{StaticResource LabelTextStyle}"
                               Opacity="0.6"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
